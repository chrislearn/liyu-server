DATABASE_URL=postgres://root:root@127.0.0.1:5432/liyu_dev
LIYU_BIND=127.0.0.1:8787

# Maximum PostgreSQL connections in the application pool
LIYU_DB_POOL_MAX_SIZE=8
# Relative paths resolve from the server working directory
LIYU_DATA_DIR=test-data
# Creates or synchronizes the named administrator on server startup
LIYU_ADMIN_USERNAME=
LIYU_ADMIN_PASSWORD=
# Enable for HTTPS deployments
LIYU_ADMIN_COOKIE_SECURE=false
