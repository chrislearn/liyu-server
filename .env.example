DATABASE_URL=postgres://root:root@127.0.0.1:5432/liyu_dev
LIYU_BIND=127.0.0.1:8787

# Maximum PostgreSQL connections in the application pool
LIYU_DB_POOL_MAX_SIZE=8
# Relative paths resolve from the server working directory
LIYU_DATA_DIR=test-data
# Creates or synchronizes the named administrator on server startup
LIYU_ADMIN_USERNAME=
LIYU_ADMIN_PASSWORD=
# Enable for HTTPS deployments
LIYU_ADMIN_COOKIE_SECURE=false

# Contact delivery: direct server startup uses real verification by default.
# just dev explicitly defaults to the local test channel; it returns test_code.
# LIYU_TEST_DELIVERY=false
# HTTPS bridge implementing the JSON contract in docs/contact-delivery.md.
# LIYU_DELIVERY_WEBHOOK=https://delivery.example.com/send
# LIYU_DELIVERY_TOKEN=<private bridge credential>
# LIYU_PUBLIC_URL=https://liyu.example.com
