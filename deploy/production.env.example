COMPOSE_PROJECT_NAME=liyu-production
# Use the release image or its verified sha256 digest.
LIYU_IMAGE=ghcr.io/chrislearn/liyu-server:v0.1.1
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
LIYU_PUBLIC_URL=https://liyu.taidge.com
# Caddy on the host proxies to 127.0.0.1:8787. No Caddy container here.
LIYU_SERVER_PORT=8787
LIYU_ADMIN_USERNAME=admin
LIYU_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Configure your real mail/SMS delivery bridge before registration.
LIYU_DELIVERY_WEBHOOK=
LIYU_DELIVERY_TOKEN=
