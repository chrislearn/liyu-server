COMPOSE_PROJECT_NAME=liyu-production
# Choose a verified release image/digest or a local build; do not leave blank.
# liyu-mini 1.0.45 requires server 0.1.6 pagination; this source version is unreleased.
LIYU_IMAGE=
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Explicit fixed-code fallback when either delivery setting is missing.
LIYU_TEST_MODE=false
LIYU_PUBLIC_URL=https://liyu.taidge.com
# Caddy on the host proxies to 127.0.0.1:8787. No Caddy container here.
LIYU_SERVER_PORT=8787
LIYU_ADMIN_USERNAME=admin
LIYU_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Configure your real mail/SMS delivery bridge before registration.
LIYU_DELIVERY_WEBHOOK=
LIYU_DELIVERY_TOKEN=
