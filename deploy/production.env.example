COMPOSE_PROJECT_NAME=liyu-production
# Replace after the first successful GHCR publication; pin a release tag or digest.
LIYU_IMAGE=ghcr.io/chrislearn/liyu-server:main
# Use random hex strings (openssl rand -hex 32); no URL-reserved characters.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
LIYU_ENV=production
LIYU_TEST_DELIVERY=false
LIYU_DOMAIN=liyu.example.com
LIYU_PUBLIC_URL=https://liyu.example.com
ACME_EMAIL=operator@example.com
LIYU_HTTP_BIND=80
LIYU_HTTPS_BIND=443
LIYU_ADMIN_USERNAME=admin
LIYU_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Required to send registration/binding verification and gift invitations.
LIYU_DELIVERY_WEBHOOK=https://delivery.example.com/send
LIYU_DELIVERY_TOKEN=REPLACE_WITH_PROVIDER_TOKEN
