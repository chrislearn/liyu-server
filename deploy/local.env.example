COMPOSE_PROJECT_NAME=liyu-local
POSTGRES_PASSWORD=local-development-only
LIYU_IMAGE=liyu-server:local
LIYU_ENV=development
LIYU_TEST_DELIVERY=true
LIYU_HTTP_BIND=127.0.0.1:8080
LIYU_HTTPS_BIND=127.0.0.1:8443
LIYU_PUBLIC_URL=https://liyu.localhost:8443
LIYU_ADMIN_USERNAME=local-admin
LIYU_ADMIN_PASSWORD=local-admin-password-change-me
